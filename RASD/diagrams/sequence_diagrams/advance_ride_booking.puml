@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white

    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black

    ActorBorderColor #444444
    ActorBackgroundColor white
    ActorFontColor black

    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7

    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }

  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }

  lifeLine {
    LineColor #444444
    BackgroundColor white
  }

  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

actor "Passenger" as P
participant "ROAd System" as ROAD
participant "External Mapping Service" as MAP

activate P

P -> ROAD : submitAdvanceBooking(pickup, destination, dateTime)
activate ROAD

ROAD -> ROAD : validateBookingRequest()

alt invalid request
    ROAD --> P : requestRejected(reason)

else valid request
    ROAD -> ROAD : identifyCandidateRobotaxis(dateTime)

    opt routing information required
        ROAD -> MAP : requestRoutesAndTravelTimes(pickup, destination,\nrobotaxiPositions)
        activate MAP
        MAP --> ROAD : routingInformation
        deactivate MAP
    end

    ROAD -> ROAD : evaluateReservationFeasibility()

    alt suitable robotaxi can be reserved without conflicts
        ROAD -> ROAD : reserveVehicleAndRecordBooking()
        ROAD --> P : bookingConfirmed(bookingInfo)

    else no feasible reservation
        ROAD --> P : requestRejected(noSuitableVehicleOrConflictingReservation)
    end
end

deactivate ROAD
deactivate P

@enduml