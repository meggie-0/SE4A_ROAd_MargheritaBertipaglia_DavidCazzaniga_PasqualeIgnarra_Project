@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white

    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black

    ActorBorderColor #444444
    ActorBackgroundColor white
    ActorFontColor black

    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7

    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }

  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }

  lifeLine {
    LineColor #444444
    BackgroundColor white
  }

  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

actor "Passenger" as P
participant "ROAd System" as ROAD
participant "External Mapping Service" as MAP
participant "Robotaxi" as ROBOTAXI

activate P

P -> ROAD : submitImmediateRideRequest(pickup, destination)
activate ROAD

ROAD -> ROAD : validateRequest()

alt invalid request
    ROAD --> P : requestRejected(reason)

else valid request
    ROAD -> ROAD : identifyEligibleRobotaxis()

    opt routing information required
        ROAD -> MAP : requestRoutesAndTravelTimes(pickup, destination,\nrobotaxiPositions)
        activate MAP
        MAP --> ROAD : routingInformation
        deactivate MAP
    end

    ROAD -> ROAD : evaluateAllocationUsingActiveStrategy()

    alt suitable robotaxi can be assigned
        ROAD -> ROAD : acceptRequestAndAssignRobotaxi()
        ROAD --> P : vehicleAssigned(robotaxi)

        ROAD -> ROBOTAXI : proceedToPickup(pickup)
        activate ROBOTAXI

        ROAD ->> P : vehicleArriving(estimatedArrivalTime)

        ||80||

        ROBOTAXI ->> ROAD : pickupReached()
        deactivate ROBOTAXI

        ROAD ->> P : vehicleArrived()

    else no suitable robotaxi can be assigned
        ROAD --> P : requestRejected(noSuitableVehicle)
    end
end

deactivate ROAD
deactivate P

@enduml