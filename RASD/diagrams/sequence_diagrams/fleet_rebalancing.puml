@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white

    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black

    ActorBorderColor #444444
    ActorBackgroundColor white
    ActorFontColor black

    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7

    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }

  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }

  lifeLine {
    LineColor #444444
    BackgroundColor white
  }

  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

participant "ROAd System" as ROAD
actor "Fleet Operator" as OP
participant "Robotaxi" as TAXI

activate OP
activate ROAD

ROAD -> ROAD : periodicallyEvaluateRebalancing()
ROAD -> ROAD : estimateZoneDemand()
ROAD -> ROAD : compareDemandWithAvailableVehicles()

alt zones with unmet demand exist
    loop for each target zone, in decreasing deficit order
        ROAD -> ROAD : selectEligibleIdleRobotaxiFromSurplusZone()

        opt suitable robotaxi can be repositioned
            ROAD -> ROAD : initiateRebalancingAction(robotaxi, targetZone)
            ROAD ->> TAXI : proceedToZone(targetZone)
            activate TAXI

            ROAD ->> OP : rebalancingStarted(robotaxi, targetZone)

            ||80||

            deactivate TAXI
        end
    end

else no demand imbalance
    ROAD -> ROAD : retainCurrentRebalancingPlan()
end

deactivate ROAD
deactivate OP

@enduml