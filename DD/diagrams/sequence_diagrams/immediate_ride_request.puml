@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white
    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black
    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7
    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }
  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }
  lifeLine {
    LineColor #444444
    BackgroundColor white
  }
  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

' Component-level view: arguments and returned DTOs are abbreviated.
' PersistenceManager includes database access; its internal SQL is omitted.
' Internal helper work is grouped under the component that owns it.
' Calls to update(event) include subject notification where applicable.
' WebSocket delivery uses the sessions registered by the API Gateway.

participant "p:PassengerClient" as P
participant "api:APIGateway" as API
participant "rrm:RideRequestManager" as RRM
participant "pm:PersistenceManager" as PM
participant "fm:FleetMonitor" as FM
participant "am:AllocationManager" as AM
participant "esg:ExternalServicesGateway" as ESG
participant "nm:NotificationManager" as NM

activate P
P -> API : submitImmediateRide(pickup, destination)
activate API
API -> API : authenticate and validate payload
API -> RRM : submitImmediate(draft)
activate RRM

RRM -> PM : create(ride_request, PENDING)
activate PM
PM --> RRM : request
deactivate PM

RRM -> ESG : getETA(pickupOrigin, destination)
activate ESG
ESG --> RRM : estimatedRideDuration
deactivate ESG

opt ride duration can be estimated
    RRM -> FM : getCandidates()
    activate FM
    FM --> RRM : candidates
    deactivate FM

    loop while not allocated and candidates remain
        RRM -> AM : allocate(request, remainingCandidates)
        activate AM
        AM -> AM : resolve persisted active strategy

        alt MINIMUM_ETA
            AM -> ESG : getETA(remainingCandidates, pickup)
            activate ESG
            ESG --> AM : etaList
            deactivate ESG
        else NEAREST_AVAILABLE
            AM -> AM : score candidates by geographical distance
        end

        AM --> RRM : selectedRobotaxi or null
        deactivate AM

        alt a robotaxi was selected
            RRM -> RRM : remove selected robotaxi from remaining candidates
            RRM -> ESG : getETA(selectedRobotaxiOrigin, pickup)
            activate ESG
            ESG --> RRM : etaToPickup
            deactivate ESG

            opt pickup ETA can be estimated
                RRM -> RRM : compute bounded reservation window
                RRM -> PM : reserve(vehicle, request, window,\nrequest-to-vehicle link)
                activate PM
                note right of PM
                    Reservation and request-to-vehicle link
                    are written in the same transaction.
                    Overlapping reservations are rejected.
                end note
                PM --> RRM : reservationResult
                deactivate PM

                opt reservation committed
                    RRM -> FM : assign(robotaxiId, rideAssignment)
                    activate FM

                    alt transition legal and conditional write succeeds
                        FM -> NM : update(RobotaxiStateChangedEvent)
                        activate NM
                        NM ->> API : push(assignment notification)
                        API ->> P : assignment notification
                        deactivate NM
                        FM --> RRM : assignment completed
                    else illegal transition or concurrent state change
                        FM --> RRM : transition error
                    end
                    deactivate FM

                    alt assignment completed
                        RRM -> RRM : mark allocation successful
                    else assignment failed
                        RRM -> PM : update(reservation, releasedAt)
                        activate PM
                        deactivate PM
                    end
                end
            end
        else no candidate can be selected
            RRM -> RRM : stop candidate search
        end
    end
end

alt allocation succeeded
    RRM -> PM : update(ride_request, ACCEPTED)
    activate PM
    deactivate PM
    RRM -> PM : create(ride, SCHEDULED, robotaxiId)
    activate PM
    deactivate PM
    RRM -> NM : update(RideStatusChangedEvent: SCHEDULED)
    activate NM
    NM ->> API : push(ride confirmation notification)
    API ->> P : ride confirmation notification
    deactivate NM
    RRM --> API : accepted outcome
    API --> P : ride confirmation
else no feasible allocation or missing travel estimate
    RRM -> PM : update(ride_request, REJECTED, assignedRobotaxiId = null)
    activate PM
    deactivate PM
    RRM --> API : rejected outcome
    API --> P : request rejected
end

deactivate RRM
deactivate API
deactivate P

@enduml
