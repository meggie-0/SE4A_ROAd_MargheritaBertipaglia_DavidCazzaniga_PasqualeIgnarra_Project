@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white
    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black
    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7
    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }
  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }
  lifeLine {
    LineColor #444444
    BackgroundColor white
  }
  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

participant "scheduler:RebalancingScheduler" as Scheduler
participant "rbm:RebalancingManager" as RBM
participant "pm:PersistenceManager" as PM
participant "fm:FleetMonitor" as FM
participant "esg:ExternalServicesGateway" as ESG
participant "nm:NotificationManager" as NM
participant "api:APIGateway" as API
participant "operatorClient:FleetOperatorClient" as Operator

activate Scheduler

Scheduler -> RBM: rebalance()
activate RBM

RBM -> PM: getDemandData()
activate PM
PM --> RBM: demandData
deactivate PM

RBM -> FM: getAvailableRobotaxis()
activate FM
FM --> RBM: availableRobotaxis
deactivate FM

RBM -> RBM: analyzeDemand(demandData,\navailableRobotaxis)

RBM -> RBM: identifyDeficitZones()
RBM -> RBM: selectVehiclesAndTargetZones()

alt rebalancing needed

    loop for each selected robotaxi

        RBM -> FM: requestRebalancing(robotaxi)
        activate FM
        FM --> RBM: rebalancingStarted
        deactivate FM

        RBM -> PM: saveRebalancingAction(robotaxi,\ntargetZone)
        activate PM
        PM --> RBM: actionSaved
        deactivate PM

        RBM -> ESG: commandRoute(robotaxi,\ntargetZone)
        activate ESG
        ESG --> RBM: commandAccepted
        deactivate ESG

        RBM ->> NM: update(RebalancingStartedEvent)
        activate NM
        NM ->> API: push(RebalancingStartedEvent)
        API ->> Operator: push(RebalancingStartedEvent)
        deactivate NM

    end

else no rebalancing needed

    RBM -> RBM: keepCurrentFleetDistribution()

end

RBM --> Scheduler: rebalancingCompleted

deactivate RBM
deactivate Scheduler

@enduml
