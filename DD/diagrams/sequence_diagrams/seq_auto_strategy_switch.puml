@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white
    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black
    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7
    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }
  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }
  lifeLine {
    LineColor #444444
    BackgroundColor white
  }
  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

participant "tm:TrafficMonitor" as TM
participant "esg:ExternalServicesGateway" as ESG
participant "mc:ModeController" as MC
participant "am:AllocationManager" as AM
participant "pm:PersistenceManager" as PM
participant "nm:NotificationManager" as NM
participant "api:APIGateway" as API
participant "operatorClient:FleetOperatorClient" as Operator


== Automatic strategy switching in Auto Mode ==

TM -> ESG : getTraffic()
activate ESG
ESG --> TM : trafficLevel
deactivate ESG

TM -> MC : onTrafficLevel(level)
activate MC

MC -> PM : getMode()
activate PM
PM --> MC : modeReading
deactivate PM

MC -> PM : updateTrafficLevel(level)
activate PM
PM --> MC : levelUpdated
deactivate PM

MC -> MC : checkHysteresis(level)

alt manual mode enabled

    MC -> MC : ignoreAutomaticSwitch()

else auto mode and strategy switch required

    MC -> AM : setActiveStrategy(strategy,\nAUTO)
    activate AM

    AM -> PM : update(strategyConfig)
    activate PM
    PM --> AM : strategyUpdated
    deactivate PM

    AM --> MC : strategyUpdated
    deactivate AM

    MC ->> NM : update(StrategyChangedEvent)
    activate NM
    NM ->> API : push(StrategyChangedEvent)
    API ->> Operator : push(StrategyChangedEvent)
    deactivate NM

else MEDIUM threshold reached

    MC -> MC : keepCurrentStrategy()

    MC ->> NM : update(TrafficAlertEvent)
    activate NM
    NM ->> API : push(TrafficAlertEvent)
    API ->> Operator : push(TrafficAlertEvent)
    deactivate NM

else no strategy switch required

    MC -> MC : keepCurrentStrategy()

end

deactivate MC


== Human manual override ==

Operator -> API : setManualStrategy(strategy)
activate API

API -> MC : setManual(strategy)
activate MC

MC -> AM : setActiveStrategy(strategy,\nMANUAL)
activate AM

AM -> PM : update(strategyAndModeConfig)
activate PM
PM --> AM : strategyAndModeUpdated
deactivate PM

AM --> MC : strategyAndModeUpdated
deactivate AM

MC ->> NM : update(ManualOverrideEvent)
activate NM
NM ->> API : push(ManualOverrideEvent)
API ->> Operator : push(ManualOverrideEvent)
deactivate NM

MC --> API : manualModeEnabled
deactivate MC

API --> Operator : manualOverrideConfirmation
deactivate API


== Return to Auto Mode ==

Operator -> API : enableAutoMode()
activate API

API -> MC : enableAuto()
activate MC

MC -> PM : updateMode(AUTO)
activate PM
PM --> MC : autoModeEnabled
deactivate PM

MC -> MC : reevaluateLastTrafficLevel()

alt strategy switch required

    MC -> AM : setActiveStrategy(strategy,\nAUTO)
    activate AM

    AM -> PM : update(strategyConfig)
    activate PM
    PM --> AM : strategyUpdated
    deactivate PM

    AM --> MC : strategyUpdated
    deactivate AM

    MC ->> NM : update(StrategyChangedEvent)
    activate NM
    NM ->> API : push(StrategyChangedEvent)
    API ->> Operator : push(StrategyChangedEvent)
    deactivate NM

else current strategy retained

    MC ->> NM : update(ModeChangedEvent)
    activate NM
    NM ->> API : push(ModeChangedEvent)
    API ->> Operator : push(ModeChangedEvent)
    deactivate NM

end

MC --> API : autoModeEnabled
deactivate MC

API --> Operator : autoModeConfirmation
deactivate API

@enduml
