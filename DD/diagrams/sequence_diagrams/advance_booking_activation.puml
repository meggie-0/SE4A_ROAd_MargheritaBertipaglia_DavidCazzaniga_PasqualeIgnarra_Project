@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 150
skinparam maxMessageSize 90

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #444444
    LifeLineBackgroundColor white
    ParticipantBorderColor #444444
    ParticipantBackgroundColor white
    ParticipantFontColor black
    GroupBorderColor #444444
    GroupBackgroundColor #F7F7F7
    DividerBorderColor #444444
    DividerBackgroundColor #F2F2F2
}

<style>
sequenceDiagram {
  participant {
    Padding 20
  }
  group {
    Padding 10
    BackgroundColor #F7F7F7
    LineColor #444444
  }
  lifeLine {
    LineColor #444444
    BackgroundColor white
  }
  arrow {
    LineColor black
  }
}
</style>

hide footbox
autonumber

participant "sched:AdvanceBookingSchedule" as sched
participant "aba:AdvanceBookingActivator" as aba
participant "pm:PersistenceManager" as pm
participant "fm:FleetMonitor" as fm
participant "am:AllocationManager" as am

sched -> aba: activateDueBookings(now)

aba -> pm: getDueBookings(now)
activate pm
pm --> aba: dueBookings
deactivate pm

loop for each due booking

    aba -> fm: getCandidates()
    activate fm
    fm --> aba: candidates
    deactivate fm

    alt reserved robotaxi still eligible

        aba -> fm: assign(reservedRobotaxi, request)
        activate fm
        fm --> aba: assignmentConfirmed
        deactivate fm

    else reserved robotaxi no longer eligible

        aba -> pm: filterAvailable(candidates, timeWindow)
        activate pm
        pm --> aba: availableCandidates
        deactivate pm

        aba -> am: allocate(request, availableCandidates)
        activate am
        am --> aba: selectedRobotaxi
        deactivate am

        alt feasible robotaxi found

            aba -> pm: reserve(request, selectedRobotaxi, timeWindow)
            activate pm
            pm --> aba: reservationConfirmed
            deactivate pm

            aba -> fm: assign(selectedRobotaxi, request)
            activate fm
            fm --> aba: assignmentConfirmed
            deactivate fm

        else no feasible robotaxi

            aba -> pm: update(request, REJECTED)
            activate pm
            pm --> aba: updateConfirmed
            deactivate pm

        end
    end
end

@enduml
