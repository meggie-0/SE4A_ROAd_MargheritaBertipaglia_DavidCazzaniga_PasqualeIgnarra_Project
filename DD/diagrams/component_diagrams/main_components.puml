@startuml

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam dpi 150
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor black

skinparam component {
    BackgroundColor white
    BorderColor #444444
    FontColor black
}
skinparam interface {
    BackgroundColor white
    BorderColor #444444
    FontColor black
}
skinparam package {
    BackgroundColor white
    BorderColor #444444
    FontColor black
}
skinparam database {
    BackgroundColor white
    BorderColor #444444
    FontColor black
}
skinparam node {
    BackgroundColor white
    BorderColor #444444
    FontColor black
}
skinparam note {
    BackgroundColor #F7F7F7
    BorderColor #444444
    FontColor black
}

top to bottom direction

' Components represent module-level responsibilities, including internal helpers.
' Only principal service dependencies are shown.
' Scheduler/lifecycle/telemetry ports and shared domain vocabulary are omitted.
' IRebalancingService is the design-level name of the code's RebalancingPort.

together {
    component "Passenger Client" as PassengerClient
    component "Fleet Operator Client" as OperatorClient
}

package "Backend" as Backend {
    component "API Gateway" as APIGateway
    () "<b>IClientAPI</b>" as IClientAPI
    () "<b>IOperatorAPI</b>" as IOperatorAPI

    component "Authentication Manager" as AuthenticationManager
    () "<b>IAuthenticationService</b>" as IAuthenticationService

    component "Ride Request Manager" as RideRequestManager
    () "<b>IRideRequestService</b>" as IRideRequestService

    component "Fleet Monitor" as FleetMonitor
    () "<b>IFleetMonitorService</b>" as IFleetMonitorService

    component "Mode Controller" as ModeController
    () "<b>IModeControlService</b>" as IModeControlService

    component "Maintenance Manager" as MaintenanceManager
    () "<b>IMaintenanceService</b>" as IMaintenanceService

    component "Allocation Manager" as AllocationManager
    () "<b>IAllocationService</b>" as IAllocationService

    component "Rebalancing Manager" as RebalancingManager
    () "<b>IRebalancingService</b>" as IRebalancingService

    component "Notification Manager" as NotificationManager
    () "<b>INotificationService</b>" as INotificationService
    () "<b>INotificationSessionService</b>" as INotificationSessionService
    () "<b>IOperatorAlertService</b>" as IOperatorAlertService

    component "Persistence Manager" as PersistenceManager
    () "<b>IPersistenceService</b>" as IPersistenceService

    component "External Services Gateway" as ExternalServicesGateway
    () "<b>IExternalServices</b>" as IExternalServices
}

database "ROAd Database\naccounts, rides, reservations,\nfleet, demand and alerts" as DB
node "Mapping / Routing Providers" as Maps
node "Traffic Source / Robotaxi Fleet\nSimulated by local adapters\nin the prototype" as FleetTraffic

PassengerClient --( IClientAPI
OperatorClient --( IOperatorAPI
APIGateway -up- IClientAPI
APIGateway -up- IOperatorAPI

AuthenticationManager -- IAuthenticationService
RideRequestManager -- IRideRequestService
FleetMonitor -- IFleetMonitorService
ModeController -- IModeControlService
MaintenanceManager -- IMaintenanceService
AllocationManager -- IAllocationService
RebalancingManager -- IRebalancingService
NotificationManager -- INotificationService
NotificationManager -- INotificationSessionService
NotificationManager -- IOperatorAlertService
PersistenceManager -- IPersistenceService
ExternalServicesGateway -- IExternalServices

APIGateway --( IAuthenticationService
APIGateway --( IRideRequestService
APIGateway --( IFleetMonitorService
APIGateway --( IModeControlService
APIGateway --( IMaintenanceService
APIGateway --( IAllocationService
APIGateway --( IRebalancingService
APIGateway --( INotificationSessionService
APIGateway --( IOperatorAlertService

AuthenticationManager --( IPersistenceService

RideRequestManager --( IAllocationService
RideRequestManager --( IFleetMonitorService
RideRequestManager --( IPersistenceService
RideRequestManager --( IExternalServices
RideRequestManager --( INotificationService

AllocationManager --( IPersistenceService
AllocationManager --( IExternalServices

ModeController --( IAllocationService
ModeController --( IPersistenceService
ModeController --( INotificationService
ModeController --( IExternalServices

FleetMonitor --( IPersistenceService
FleetMonitor --( INotificationService

MaintenanceManager --( IPersistenceService
MaintenanceManager --( INotificationService

RebalancingManager --( IFleetMonitorService
RebalancingManager --( IPersistenceService
RebalancingManager --( IExternalServices
RebalancingManager --( INotificationService

NotificationManager --( IPersistenceService

PersistenceManager --> DB : database access
ExternalServicesGateway --> Maps : routing / ETA
ExternalServicesGateway --> FleetTraffic : traffic / commands / telemetry
PassengerClient ..> Maps : geocoding / road snapping

note bottom of Backend
    Main inter-component service dependencies.
    ModeController includes TrafficMonitor; RideRequestManager includes
    booking activation, ride lifecycle and fleet telemetry services.
    Maintenance uses the Robotaxi domain model, not FleetMonitor's service.
end note

@enduml

