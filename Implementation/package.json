{
  "name": "road",
  "version": "0.1.0",
  "private": true,
  "description": "ROAd — Robotaxi Optimized Allocation. Monorepo del prototipo.",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "verify": "node tools/verify/verify.mjs",
    "build:packages": "pnpm --filter @road/shared build && pnpm --filter @road/simulator build",
    "typecheck": "node tools/typecheck/typecheck.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "arch": "node tools/arch/arch.mjs",
    "contract": "pnpm build:packages && jest --selectProjects contract",
    "contract:update": "node tools/contract/update.mjs",
    "test:unit": "pnpm build:packages && jest --selectProjects unit",
    "test:int": "pnpm build:packages && jest --selectProjects integration --passWithNoTests",
    "test:gate": "pnpm build:packages && jest --selectProjects gate",
    "gate": "pnpm build:packages && node tools/gate/gate.mjs",
    "trace": "node tools/trace/trace.mjs",
    "verify:e2e": "node tools/e2e/run.mjs",
    "dev": "node tools/dev/dev.mjs",
    "db:migrate": "node tools/db/migrate.mjs",
    "db:seed": "node tools/db/seed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "dependency-cruiser": "^17.0.1",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
