{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Ritorna 200 quando l'API è in grado di servire richieste.",
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Stato del servizio",
        "tags": [
          "system"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Crea un account `PASSENGER` e restituisce il primo access token. Il ruolo non è un parametro: il RASD prevede la registrazione dei soli passeggeri, mentre gli account operatore sono forniti dall'amministrazione del sistema.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "L'indirizzo è già registrato."
          }
        },
        "summary": "Registra un passeggero",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Vale per entrambi i ruoli. Restituisce un solo access token, senza refresh.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Credenziali non valide."
          }
        },
        "summary": "Autentica un utente",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "patch": {
        "description": "R2: informazioni personali e credenziali. Si può aggiornare **solo** il proprio profilo — l'utente da modificare viene dal token, non dal corpo della richiesta. La password nuova non compare nella risposta, e il token in corso resta valido perché non porta nulla che questa operazione possa cambiare.",
        "operationId": "AuthController_patchProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "404": {
            "description": "L'account del token non esiste più."
          },
          "409": {
            "description": "Il nuovo indirizzo è già di un altro account."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Aggiorna il proprio profilo",
        "tags": [
          "auth"
        ]
      }
    },
    "/allocation/strategy": {
      "get": {
        "description": "R8: la dashboard operatore mostra sempre quale politica sta assegnando i veicoli (DD §3.2). Il valore viene dal record `system_mode`, l'unica sede autorevole.",
        "operationId": "AllocationController_getActiveStrategy",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveStrategyResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "403": {
            "description": "Serve un account operatore."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Legge la strategia di allocazione attiva",
        "tags": [
          "allocation"
        ]
      },
      "put": {
        "description": "R8: il cambio ha effetto sulla prima allocazione successiva, senza interruzione del servizio. Essendo una scelta umana porta il sistema in modo Manual nella stessa transazione, e da quel momento nessun cambio automatico avviene finché un operatore non riabilita il modo Auto (NFR10, M6).",
        "operationId": "AllocationController_setActiveStrategy",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveStrategyRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveStrategyResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "403": {
            "description": "Serve un account operatore."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambia la strategia di allocazione",
        "tags": [
          "allocation"
        ]
      }
    },
    "/rides/immediate": {
      "post": {
        "description": "R3: il sistema persiste la richiesta, chiede i candidati alla flotta, li passa alla strategia attiva, riserva la finestra del veicolo scelto e lo porta ad `ASSIGNED`. Se nessun veicolo è idoneo la risposta è comunque 201, con `status: REJECTED`.",
        "operationId": "RidesController_submitImmediate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitImmediateRideRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideRequestResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "403": {
            "description": "Serve un account passeggero."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Richiede una corsa immediata",
        "tags": [
          "rides"
        ]
      }
    },
    "/rides/advance": {
      "post": {
        "description": "R4: i candidati vengono filtrati sulla timeline prima della scelta, e la prenotazione accettata scrive prenotazione e riserva nella stessa transazione (NFR4). Il veicolo **non** viene assegnato adesso: lo sarà poco prima dell'orario, e se nel frattempo non fosse più idoneo il sistema ne sceglie un altro.",
        "operationId": "RidesController_submitAdvance",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAdvanceBookingRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideRequestResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "L'orario richiesto non è successivo ad adesso."
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "403": {
            "description": "Serve un account passeggero."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Prenota una corsa per un orario futuro",
        "tags": [
          "rides"
        ]
      }
    },
    "/rides/{rideRequestId}/cancel": {
      "post": {
        "description": "R14: la richiesta passa a `CANCELLED`, la riserva viene rilasciata e la finestra torna prenotabile; se un veicolo era già stato assegnato, torna disponibile. Non si può annullare una corsa già cominciata.",
        "operationId": "RidesController_cancel",
        "parameters": [
          {
            "name": "rideRequestId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideRequestResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, scaduto o non valido."
          },
          "403": {
            "description": "Serve un account passeggero."
          },
          "404": {
            "description": "Nessuna richiesta con quell identificatore, per te."
          },
          "409": {
            "description": "La richiesta non è più attiva, oppure il veicolo è già in viaggio."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Annulla una richiesta di corsa",
        "tags": [
          "rides"
        ]
      }
    }
  },
  "info": {
    "title": "ROAd API",
    "description": "Contratto pubblico del backend ROAd. È la sola cosa che i client devono conoscere: nessun client importa codice da apps/api.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok",
            "description": "Stato del servizio."
          },
          "service": {
            "type": "string",
            "example": "road-api",
            "description": "Nome del servizio che risponde."
          },
          "version": {
            "type": "string",
            "example": "0.1.0",
            "description": "Versione dell'API in esecuzione."
          },
          "time": {
            "type": "string",
            "example": "2026-01-01T08:00:00.000Z",
            "description": "Istante della risposta in ISO 8601, letto da ClockPort."
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time"
        ]
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "example": "giulia.rossi@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "format": "password",
            "description": "Almeno 8 caratteri. Non viene mai restituita né registrata."
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Giulia"
          },
          "surname": {
            "type": "string",
            "maxLength": 120,
            "example": "Rossi"
          },
          "phoneNumber": {
            "type": "string",
            "maxLength": 40,
            "example": "+39 333 1234567"
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "surname"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "PASSENGER",
              "OPERATOR"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Istante di creazione, letto da ClockPort."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "surname",
          "phoneNumber",
          "role",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access token JWT da inviare come header `Authorization: Bearer`."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expiresInSeconds": {
            "type": "number",
            "description": "Durata del token in secondi. Non esiste refresh token: scaduto il token si rifà il login."
          },
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresInSeconds",
          "user"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "giulia.rossi@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "format": "password"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "surname": {
            "type": "string",
            "maxLength": 120
          },
          "phoneNumber": {
            "type": "object",
            "maxLength": 40,
            "nullable": true,
            "description": "Ometterlo lo lascia invariato; `null` lo cancella."
          }
        }
      },
      "ActiveStrategyResponseDto": {
        "type": "object",
        "properties": {
          "activeStrategy": {
            "type": "string",
            "enum": [
              "NEAREST_AVAILABLE",
              "MINIMUM_ETA"
            ],
            "example": "NEAREST_AVAILABLE",
            "description": "La politica con cui il sistema sta assegnando i veicoli in questo momento."
          }
        },
        "required": [
          "activeStrategy"
        ]
      },
      "SetActiveStrategyRequestDto": {
        "type": "object",
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "NEAREST_AVAILABLE",
              "MINIMUM_ETA"
            ],
            "example": "MINIMUM_ETA",
            "description": "La politica da rendere attiva. La scelta di un operatore è per definizione un intervento manuale: porta il sistema in modo Manual e sospende i cambi automatici (NFR10)."
          }
        },
        "required": [
          "strategy"
        ]
      },
      "GeoPointDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 45.4642,
            "minimum": -90,
            "maximum": 90,
            "description": "Latitudine."
          },
          "lon": {
            "type": "number",
            "example": 9.19,
            "minimum": -180,
            "maximum": 180,
            "description": "Longitudine."
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      },
      "SubmitImmediateRideRequestDto": {
        "type": "object",
        "properties": {
          "pickup": {
            "description": "Dove il passeggero vuole essere prelevato.",
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPointDto"
              }
            ]
          },
          "pickupAddress": {
            "type": "string",
            "example": "Piazza del Duomo, Milano"
          },
          "destination": {
            "description": "Dove la corsa deve terminare.",
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPointDto"
              }
            ]
          },
          "destinationAddress": {
            "type": "string",
            "example": "Stazione Centrale, Milano"
          }
        },
        "required": [
          "pickup",
          "destination"
        ]
      },
      "RideRequestResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "IMMEDIATE",
              "ADVANCE"
            ],
            "example": "IMMEDIATE"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED",
              "CANCELLED",
              "COMPLETED"
            ],
            "example": "ACCEPTED",
            "description": "Lo stato della richiesta. `REJECTED` significa che nessun veicolo era idoneo; `ACCEPTED` che uno è stato riservato — e, per una corsa immediata, anche assegnato."
          },
          "pickup": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "pickupAddress": {
            "type": "string",
            "nullable": true,
            "example": "Piazza del Duomo, Milano"
          },
          "destination": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "destinationAddress": {
            "type": "string",
            "nullable": true,
            "example": "Stazione Centrale, Milano"
          },
          "assignedRobotaxiId": {
            "type": "string",
            "nullable": true,
            "example": "RT-07",
            "description": "Il veicolo **assegnato**. Per una prenotazione anticipata accettata resta `null` fino all'attivazione: fino a quel momento il veicolo è riservato, e se nel frattempo finisce in manutenzione ne arriva un altro."
          },
          "scheduledPickup": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Presente solo per le prenotazioni anticipate."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "pickup",
          "pickupAddress",
          "destination",
          "destinationAddress",
          "assignedRobotaxiId",
          "scheduledPickup",
          "createdAt"
        ]
      },
      "SubmitAdvanceBookingRequestDto": {
        "type": "object",
        "properties": {
          "pickup": {
            "description": "Dove il passeggero vuole essere prelevato.",
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPointDto"
              }
            ]
          },
          "pickupAddress": {
            "type": "string",
            "example": "Piazza del Duomo, Milano"
          },
          "destination": {
            "description": "Dove la corsa deve terminare.",
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPointDto"
              }
            ]
          },
          "destinationAddress": {
            "type": "string",
            "example": "Stazione Centrale, Milano"
          },
          "scheduledPickup": {
            "type": "string",
            "example": "2026-05-04T18:30:00.000Z",
            "format": "date-time",
            "description": "L'orario concordato del prelievo, con fuso orario. Dev'essere successivo ad adesso: il sistema riserva il veicolo a partire da quell'orario meno l'anticipo di attivazione."
          }
        },
        "required": [
          "pickup",
          "destination",
          "scheduledPickup"
        ]
      }
    }
  }
}
