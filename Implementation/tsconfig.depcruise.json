{
  "$comment": "Usato solo da dependency-cruiser per risolvere gli import TypeScript dell'intero monorepo.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "incremental": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tools/simulator/src/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
